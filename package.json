{
  "name": "hotel-rate-comparator",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel rate comparison engine powered by Temporal workflows",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "dev:worker": "npm run worker --workspace=packages/backend",
    "test": "npm test --workspace=packages/backend",
    "build": "npm run build --workspaces"
  }
}
